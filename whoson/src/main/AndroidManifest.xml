<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<!--
		Merged into the app manifest at build time, so enabling this feature never
		touches app/src/main/AndroidManifest.xml.

		No theme is set on purpose: the activity inherits the application theme, the
		same way ExternalPlayerActivity does.
	-->
	<application>
		<activity
			android:name="org.jellyfin.androidtv.whoson.CastWebViewActivity"
			android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
			android:exported="false" />
	</application>

</manifest>
